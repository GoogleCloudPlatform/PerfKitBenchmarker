set all txburst <TX_BURST>
set all rxburst <RX_BURST>
enable all range
range 0 proto udp
range 0 src ip <SRC_IP> <SRC_IP> <SRC_IP> 0.0.0.1
range 0 src mac <SRC_MAC> <SRC_MAC> <SRC_MAC> 00:00:00:00:00:01
range 0 src port 1234 1234 1234 0
range 0 dst ip <DST_IP> <DST_IP> <DST_IP> 0.0.0.1
range 0 dst mac <DST_MAC> <DST_MAC> <DST_MAC> 00:00:00:00:00:01
range 0 dst port 5678 5678 5678 0
range 0 size <PACKET_SIZE> <PACKET_SIZE> <PACKET_SIZE> 0
range 1 proto udp
range 1 src ip <SRC_IP2> <SRC_IP2> <SRC_IP2> 0.0.0.1
range 1 src mac <SRC_MAC2> <SRC_MAC2> <SRC_MAC2> 00:00:00:00:00:01
range 1 src port 1234 1234 1234 0
range 1 dst ip <DST_IP2> <DST_IP2> <DST_IP2> 0.0.0.1
range 1 dst mac <DST_MAC2> <DST_MAC2> <DST_MAC2> 00:00:00:00:00:01
range 1 dst port 5678 5678 5678 0
range 1 size <PACKET_SIZE> <PACKET_SIZE> <PACKET_SIZE> 0
clr
# BEGIN_SENDER_CONFIG
# copybara:strip_begin(internal)
# Warmup port 0 separately to avoid Andromeda software punt queue overflow. The host vSwitch may drop packets if too many new flows arrive simultaneously.
# copybara:strip_end
# Warm up Port 0
set 0 count 500
start 0
sleep 1
# Warm up Port 1
set 1 count 500
start 1
sleep 1
# Stop warmup and let buffers settle
stop all
sleep 0.5
set all count 0
# Start unthrottled line-rate benchmark
start all
# END_SENDER_CONFIG
sleep <DURATION>
stop all
sleep 5
exit
