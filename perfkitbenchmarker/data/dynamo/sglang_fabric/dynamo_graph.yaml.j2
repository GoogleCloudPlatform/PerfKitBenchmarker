apiVersion: resource.nvidia.com/v1beta1
kind: ComputeDomain
metadata:
  name: {{ compute_domain_name }}
  namespace: {{ namespace }}
spec:
  numNodes: {{ compute_domain_num_nodes }}
  channel:
    resourceClaimTemplate:
      name: {{ compute_domain_channel }}
---
apiVersion: nvidia.com/v1alpha1
kind: DynamoGraphDeployment
metadata:
  name: {{ deployment_name }}
  namespace: {{ namespace }}
spec:
  envs:
    - name: HF_HOME
      value: /data/model
  services:
    Frontend:
      componentType: frontend
      replicas: {{ frontend_replicas }}
      extraPodSpec:
        mainContainer:
          image: {{ frontend_image }}
          envFrom:
            - secretRef:
                name: hf-token-secret
                optional: true
    decode:
      componentType: worker
      subComponentType: decode
      replicas: {{ decode_replicas }}
      resources:
        limits:
          gpu: "{{ gpu_count }}"
      extraPodSpec:
        resourceClaims:
          - name: compute-domain-channel
            resourceClaimTemplateName: {{ compute_domain_channel }}
        mainContainer:
          image: {{ workload_image }}
          workingDir: /workspace
          command:
            - python3
            - -m
            - dynamo.sglang
          args:
            - --model-path
            - {{ dynamo_model_id }}
            - --served-model-name
            - {{ dynamo_model_id }}
            - --tp
            - "{{ gpu_count }}"
            - --trust-remote-code
            - --disaggregation-mode
            - decode
            - --disaggregation-bootstrap-port
            - "30001"
            - --host
            - 0.0.0.0
          envFrom:
            - secretRef:
                name: hf-token-secret
                optional: true
          env:
{% for key, value in decode_env_vars.items() %}
            - name: {{ key }}
              value: "{{ value }}"
{% endfor %}
          resources:
            claims:
              - name: compute-domain-channel
    prefill:
      componentType: worker
      subComponentType: prefill
      replicas: {{ prefill_replicas }}
      resources:
        limits:
          gpu: "{{ gpu_count }}"
      extraPodSpec:
        resourceClaims:
          - name: compute-domain-channel
            resourceClaimTemplateName: {{ compute_domain_channel }}
        mainContainer:
          image: {{ workload_image }}
          workingDir: /workspace
          command:
            - python3
            - -m
            - dynamo.sglang
          args:
            - --model-path
            - {{ dynamo_model_id }}
            - --served-model-name
            - {{ dynamo_model_id }}
            - --tp
            - "{{ gpu_count }}"
            - --trust-remote-code
            - --disaggregation-mode
            - prefill
            - --disaggregation-bootstrap-port
            - "30001"
            - --host
            - 0.0.0.0
          envFrom:
            - secretRef:
                name: hf-token-secret
                optional: true
          env:
{% for key, value in prefill_env_vars.items() %}
            - name: {{ key }}
              value: "{{ value }}"
{% endfor %}
          resources:
            claims:
              - name: compute-domain-channel
