apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ benchmark_name }}-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ benchmark_name }}-deployment
  minReplicas: 1
  maxReplicas: {{ target_scale }}
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 50
