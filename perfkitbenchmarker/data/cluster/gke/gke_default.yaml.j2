# Note: This blueprint uses both Jinja2 (`{{ var }}`) and Cluster Toolkit
# (`$(vars.var)`) templating to align with existing non-GKE Cluster Toolkit
# templates in PKB. Jinja2 populates the top-level `vars:` block from PKB
# cluster specs, while `$(vars.var)` references those variables within the
# Cluster Toolkit blueprint modules (see
# https://cloud.google.com/cluster-toolkit/docs/overview).

blueprint_name: gke-gcluster-default

# j2 style {{ foo }}
vars:
  project_id: {{ project }}
  deployment_name: {{ name }}
  region: {{ region }}
  zone: {{ zone }}
  cluster_availability_type: {{ cluster_availability_type }}

# cluster-toolkit style $(vars.bar)
terraform_providers:
  google:
    source: hashicorp/google
    version: ">= 7.24.0"
    configuration:
      project: $(vars.project_id)
      region: $(vars.region)
      zone: $(vars.zone)
      compute_custom_endpoint: "https://www.googleapis.com/compute/beta/"

  google-beta:
    source: hashicorp/google-beta
    version: ">= 7.24.0"
    configuration:
      project: $(vars.project_id)
      region: $(vars.region)
      zone: $(vars.zone)
      compute_custom_endpoint: "https://www.googleapis.com/compute/beta/"

deployment_groups:
- group: primary
  modules:
  - id: gke-net-0
    source: modules/network/vpc
    settings:
      network_name: $(vars.deployment_name)-net-0
      ips_per_nat: 6
      subnetworks:
      - subnet_name: $(vars.deployment_name)-sub-0
        subnet_region: $(vars.region)
        subnet_ip: 192.168.0.0/18
      secondary_ranges_list:
      - subnetwork_name: $(vars.deployment_name)-sub-0
        ranges:
        - range_name: pods
          ip_cidr_range: 10.4.0.0/14
        - range_name: services
          ip_cidr_range: 10.0.32.0/20
      firewall_rules:
      - name: $(vars.deployment_name)-internal-0
        ranges: [192.168.0.0/16]
        allow:
        - protocol: tcp
          ports: ["0-65535"]
        - protocol: udp
          ports: ["0-65535"]
        - protocol: icmp

  - id: workload_service_account
    source: modules/project/service-account
    settings:
      name: gke-wl-sa
      project_roles:
      - logging.logWriter
      - monitoring.metricWriter
      - monitoring.viewer
      - stackdriver.resourceMetadata.writer
      - storage.objectAdmin
      - artifactregistry.reader

  - id: gke-cluster
    source: modules/scheduler/gke-cluster
    use: [gke-net-0, workload_service_account]
    settings:
      cluster_reference_type: "NAME"
      cluster_availability_type: $(vars.cluster_availability_type)
      zone: $(vars.zone)
      enable_dcgm_monitoring: true
      enable_k8s_beta_apis:
      - "resource.k8s.io/v1beta1/deviceclasses"
      - "resource.k8s.io/v1beta1/resourceclaims"
      - "resource.k8s.io/v1beta1/resourceclaimtemplates"
      - "resource.k8s.io/v1beta1/resourceslices"
      enable_private_endpoint: false
      configure_workload_identity_sa: true
      master_authorized_networks:
      # Allows your machine to interact with GKE control plane
      - cidr_block: "0.0.0.0/0"
        display_name: "kubectl-access-network"
    outputs: [instructions]

