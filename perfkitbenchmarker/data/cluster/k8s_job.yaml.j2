apiVersion: v1
kind: Service
metadata:
  name: {{ job_name }}
spec:
  clusterIP: None
  selector:
    job-name: {{ job_name }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ job_name }}
spec:
  parallelism: {{ num_workers }}
  completions: {{ num_workers }}
  completionMode: Indexed
  backoffLimit: 0
  activeDeadlineSeconds: {{ job_timeout | default(7200, true) }}
  # Requires Kubernetes >= 1.33 (batch/v1 Job successPolicy GA).
  successPolicy:
    rules:
    - succeededIndexes: "0"
  template:
    metadata:
      labels:
        job-name: {{ job_name }}
    spec:
      subdomain: {{ job_name }}
      setHostnameAsFQDN: true
      restartPolicy: Never
{%- if worker_machine_type is defined and worker_machine_type %}
      nodeSelector:
        {{ node_selector_label | default('node.kubernetes.io/instance-type') }}: {{ worker_machine_type }}
{%- endif %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                job-name: {{ job_name }}
            topologyKey: kubernetes.io/hostname
{%- if gpus_per_node is defined and gpus_per_node %}
      tolerations:
      - key: nvidia.com/gpu
        operator: Exists
        effect: NoSchedule
{%- endif %}
      volumes:
      - name: dshm
        emptyDir:
          medium: Memory
{%- if resource_claim_template is defined and resource_claim_template %}
      resourceClaims:
      - name: rdma
        resourceClaimTemplateName: {{ resource_claim_template }}
{%- endif %}
      containers:
      - name: worker
        image: {{ image }}
        securityContext:
          privileged: true
        env:
        - name: OMPI_ALLOW_RUN_AS_ROOT
          value: "1"
        - name: OMPI_ALLOW_RUN_AS_ROOT_CONFIRM
          value: "1"
{%- if env %}
{%- for key, value in env.items() %}
        - name: {{ key }}
          value: "{{ value }}"
{%- endfor %}
{%- endif %}
        volumeMounts:
        - name: dshm
          mountPath: /dev/shm
{%- if (gpus_per_node is defined and gpus_per_node) or (cpus_per_task is defined and cpus_per_task) or (extra_resources is defined and extra_resources) or (resource_claim_template is defined and resource_claim_template) %}
        resources:
{%- if (gpus_per_node is defined and gpus_per_node) or (cpus_per_task is defined and cpus_per_task) or (extra_resources is defined and extra_resources) %}
          limits:
{%- if gpus_per_node is defined and gpus_per_node %}
            nvidia.com/gpu: {{ gpus_per_node }}
{%- endif %}
{%- if cpus_per_task is defined and cpus_per_task %}
            cpu: {{ cpus_per_task }}
{%- endif %}
{%- if extra_resources is defined and extra_resources %}
{%- for key, value in extra_resources.items() %}
            {{ key }}: {{ value }}
{%- endfor %}
{%- endif %}
          requests:
{%- if gpus_per_node is defined and gpus_per_node %}
            nvidia.com/gpu: {{ gpus_per_node }}
{%- endif %}
{%- if cpus_per_task is defined and cpus_per_task %}
            cpu: {{ cpus_per_task }}
{%- endif %}
{%- if extra_resources is defined and extra_resources %}
{%- for key, value in extra_resources.items() %}
            {{ key }}: {{ value }}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if resource_claim_template is defined and resource_claim_template %}
          claims:
          - name: rdma
{%- endif %}
{%- endif %}
        command:
        - /bin/bash
        - -c
        - |
          set -e
{%- if env %}
{%- for key, value in env.items() %}
          export {{ key }}="{{ value }}"
{%- endfor %}
{%- endif %}
          # Container image requirements for this operator-less K8s Indexed Job:
          #   1. openssh-server (/usr/sbin/sshd) and openssh-client (ssh):
          #      Pod 0 runs sshd in the background and launches remote MPI ranks
          #      on pods 0..N-1 over the headless Service DNS names
          #      (<job_name>-<i>.<job_name>) without needing mpi-operator.
          #      Non-zero pods run `exec sshd -D` in the foreground until K8s
          #      terminates them via `successPolicy` (when pod 0 succeeds) or
          #      `backoffLimit: 0` / `activeDeadlineSeconds` (on failure/timeout).
          #   2. Passwordless root-to-root SSH baked into the image:
          #      Pre-generate /root/.ssh/id_rsa and copy id_rsa.pub into
          #      /root/.ssh/authorized_keys (chmod 700 /root/.ssh, 600
          #      authorized_keys) and set StrictHostKeyChecking no /
          #      UserKnownHostsFile /dev/null in /etc/ssh/ssh_config. Because
          #      every pod runs the same image, pod 0 can authenticate to all
          #      peer pods without mounting an operator-managed SSH Secret.
          #   3. OpenMPI (mpirun) installed and on PATH.
          #   4. WORKDIR set to the benchmark binary directory (e.g. the
          #      nccl-tests build directory so `./all_reduce_perf` resolves).
          mkdir -p /run/sshd
          if [ "${JOB_COMPLETION_INDEX:-0}" = "0" ]; then
            /usr/sbin/sshd -p 222
            rm -f /tmp/hostfile
            for i in $(seq 0 $(({{ num_workers }} - 1))); do
              PEER="{{ job_name }}-${i}.{{ job_name }}"
              until ssh -p 222 -o StrictHostKeyChecking=no -o ConnectTimeout=5 "${PEER}" hostname >/dev/null 2>&1; do
                sleep 2
              done
              echo "${PEER} port=222 slots={{ ntasks_per_node | default(gpus_per_node | default(1)) }}" >> /tmp/hostfile
            done
            # OpenMPI's plm_rsh launcher starts remote ranks via a clean SSH
            # non-login shell, which strips container ENV vars not explicitly
            # forwarded via `-x`. The `env` loop below forwards runtime job env
            # vars, while `compgen -v` also discovers and forwards tuning ENV
            # vars baked into the Dockerfile (e.g. NCCL_*, UCX_*, SHARP_*).
            ENV_ARGS="{% if env %}{% for key in env %}-x {{ key }} {% endfor %}{% endif %}"
            for var in $(compgen -v | grep -E '^(NCCL_|OMPI_|FI_|CUDA_|UCX_|SHARP_|LD_LIBRARY_PATH$|PATH$)'); do
              ENV_ARGS="${ENV_ARGS} -x ${var}"
            done
            mpirun \
              --allow-run-as-root \
              --hostfile /tmp/hostfile \
              ${ENV_ARGS} \
              -mca plm_rsh_no_tree_spawn 1 \
              --mca orte_keep_fqdn_hostnames 1 \
              --bind-to none \
              --mca plm_rsh_agent "ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no -p 222" \
              {{ command }}
          else
            exec /usr/sbin/sshd -D -p 222
          fi
