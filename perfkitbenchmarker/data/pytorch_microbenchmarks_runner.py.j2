"""PyTorch microbenchmark runner for physical memory bandwidth."""

import argparse
import json
import re
import time
import numpy as np
import torch

SIZES_PER_CHIP_BYTES = [1024 * (2**i) for i in range(25)]

_TIME_MULTIPLIERS = {
    'us': 1.0,
    'ms': 1e3,
    's': 1e6,
    'm': 6e7,
    'h': 3.6e9,
}


def _parse_accumulator_us(text):
  total_us = 0.0
  for value, unit in re.findall(r'(\d+(?:\.\d+)?)(us|ms|s|m|h)', text):
    total_us += float(value) * _TIME_MULTIPLIERS[unit]
  return total_us


class CudaTimer:

  def __init__(self):
    self._start_event = None
    self._end_event = None

  def start(self):
    self._start_event = torch.cuda.Event(enable_timing=True)
    self._end_event = torch.cuda.Event(enable_timing=True)
    self._start_event.record()

  def stop_and_sync(self, sync_fn, iters):
    self._end_event.record()
    sync_fn()
    return (self._start_event.elapsed_time(self._end_event) / iters) * 1000.0


class TpuTimer:

  def __init__(self):
    self._start_time = 0.0
    self._start_metrics_us = 0.0

  def _get_metrics_us(self):
    import torch_xla.debug.metrics as met
    report = met.metrics_report()
    total_us = 0.0
    for block in report.split('Metric: '):
      for metric_name in ('ExecuteTime', 'TpuExecuteTime'):
        if block.startswith(metric_name + '\n'):
          match = re.search(r'[ \t]+Accumulator: (.*?)\n', block)
          if match:
            total_us = max(total_us, _parse_accumulator_us(match.group(1)))
    return total_us

  def start(self):
    self._start_time = time.perf_counter()
    self._start_metrics_us = self._get_metrics_us()

  def stop_and_sync(self, sync_fn, iters):
    sync_fn()
    host_us = (time.perf_counter() - self._start_time) * 1e6 / iters
    diff = self._get_metrics_us() - self._start_metrics_us
    if diff > 0:
      return diff / iters
    return host_us


def _gpu_worker(rank, count, global_elems, op_name, dtype, element_size, barrier, return_dict):
  torch.cuda.set_device(rank)
  local_elems = max(global_elems // count, 1)

  if op_name == 'Triad':
    a = torch.randn(local_elems, dtype=dtype, device=f'cuda:{rank}')
    b = torch.randn(local_elems, dtype=dtype, device=f'cuda:{rank}')
    c = torch.empty_like(a)
    op = lambda: torch.add(a, b, out=c)
  elif op_name == 'Copy':
    a = torch.randn(local_elems, dtype=dtype, device=f'cuda:{rank}')
    c = torch.empty_like(a)
    op = lambda: c.copy_(a)
  elif op_name == 'Write':
    c = torch.empty(local_elems, dtype=dtype, device=f'cuda:{rank}')
    op = lambda: c.zero_()
  else:
    return

  torch.cuda.synchronize()

  for _ in range(5):
    op()
  torch.cuda.synchronize()

  try: barrier.wait(30)
  except: return

  start = torch.cuda.Event(enable_timing=True)
  end = torch.cuda.Event(enable_timing=True)
  start.record()
  for _ in range(20):
    op()
  end.record()
  torch.cuda.synchronize()

  return_dict[rank] = (start.elapsed_time(end) / 20.0) * 1000.0


def get_device_context(accelerator='auto'):
  if accelerator == 'cuda' or (accelerator == 'auto' and torch.cuda.is_available()):
    name = torch.cuda.get_device_name(0).lower().replace(' ', '-')
    return {
        'name': name,
        'is_cuda': True,
        'device': torch.device('cuda:0'),
        'total_chips': torch.cuda.device_count(),
        'max_bytes_per_chip': torch.cuda.mem_get_info()[0],
        'step_fn': lambda: None,
        'sync_fn': torch.cuda.synchronize,
        'timer': CudaTimer(),
    }

  import torch_xla.core.xla_model as xm
  import torch_xla.runtime as xr
  xr.use_spmd()

  total_chips = xr.global_runtime_device_count()

  def shard_tpu(tensor, count):
    if count <= 1 or count > total_chips:
      return
    import torch_xla.distributed.spmd as xs
    if count == total_chips:
      mesh = xs.Mesh(np.arange(total_chips), (total_chips,), ('data',))
      xs.mark_sharding(tensor, mesh, ('data',))
    elif count == 4 and total_chips == 8:
      mesh = xs.Mesh(np.arange(8), (2, 4), ('sub', 'x4'))
      xs.mark_sharding(tensor, mesh, (None,))
    elif count == 2 and total_chips == 8:
      mesh = xs.Mesh(np.arange(8), (2, 4), ('x2', 'sub'))
      xs.mark_sharding(tensor, mesh, ('x2',))
    elif total_chips % count == 0:
      sub = total_chips // count
      mesh = xs.Mesh(np.arange(total_chips), (count, sub), ('active', 'sub'))
      xs.mark_sharding(tensor, mesh, ('active',))

  device_name = accelerator if accelerator != 'auto' else 'tpu'
  return {
      'name': device_name,
      'is_cuda': False,
      'device': xm.xla_device(),
      'total_chips': total_chips,
      'max_bytes_per_chip': 16 * 1024**3,
      'step_fn': xm.mark_step,
      'sync_fn': lambda: (xm.mark_step(), xm.wait_device_ops()),
      'timer': TpuTimer(),
      'shard_tensor': shard_tpu,
  }


def run_benchmark(ctx, count, per_chip_bytes, dtype_str, op_name):
  dtype = torch.float32 if dtype_str == 'float32' else torch.bfloat16
  element_size = 4 if dtype == torch.float32 else 2
  global_elems = max((per_chip_bytes * count) // element_size, 1)

  if per_chip_bytes > ctx.get('max_bytes_per_chip', float('inf')) * 0.9:
    return None

  if op_name == 'Triad':
    bytes_multiplier = 3
  elif op_name == 'Copy':
    bytes_multiplier = 2
  elif op_name == 'Write':
    bytes_multiplier = 1
  else:
    return None

  total_bytes = bytes_multiplier * global_elems * element_size

  if ctx.get('is_cuda') and count > 1:
    import multiprocessing as mp
    mp_ctx = mp.get_context('spawn')
    manager = mp_ctx.Manager()
    return_dict = manager.dict()
    barrier = mp_ctx.Barrier(count)
    processes = [
        mp_ctx.Process(
            target=_gpu_worker,
            args=(r, count, global_elems, op_name, dtype, element_size, barrier, return_dict),
        )
        for r in range(count)
    ]
    for p in processes:
      p.start()
    for p in processes:
      p.join()
    if len(return_dict) < count:
      raise RuntimeError("RESOURCE_EXHAUSTED: child process failed to complete")
    time_us = max(return_dict.values())
  else:
    if op_name == 'Triad':
      a = torch.randn(global_elems, dtype=dtype, device=ctx['device'])
      b = torch.randn(global_elems, dtype=dtype, device=ctx['device'])
      c = torch.empty_like(a)
      if 'shard_tensor' in ctx:
        ctx['shard_tensor'](a, count)
        ctx['shard_tensor'](b, count)
        ctx['shard_tensor'](c, count)
      op = lambda: torch.add(a, b, out=c)
    elif op_name == 'Copy':
      a = torch.randn(global_elems, dtype=dtype, device=ctx['device'])
      c = torch.empty_like(a)
      if 'shard_tensor' in ctx:
        ctx['shard_tensor'](a, count)
        ctx['shard_tensor'](c, count)
      op = lambda: c.copy_(a)
    elif op_name == 'Write':
      c = torch.empty(global_elems, dtype=dtype, device=ctx['device'])
      if 'shard_tensor' in ctx:
        ctx['shard_tensor'](c, count)
      op = lambda: c.zero_()

    ctx['sync_fn']()

    for _ in range(5):
      op()
      ctx['step_fn']()
    ctx['sync_fn']()

    iters = 20

    ctx['timer'].start()
    for _ in range(iters):
      op()
      ctx['step_fn']()
    time_us = ctx['timer'].stop_and_sync(ctx['sync_fn'], iters)

  time_sec = time_us / 1e6
  aggregate_bandwidth_gbps = (total_bytes / 1e9) / time_sec
  per_chip_bw = aggregate_bandwidth_gbps / count
  per_chip_transfer_bytes = total_bytes / count

  output = {
      'test_name': f'{op_name}_{dtype_str}_{ctx["name"]}_chips{count}',
      'op_name': op_name,
      'dtype': dtype_str,
      'array_size_bytes_per_chip': per_chip_bytes,
      'message_size_bytes': per_chip_transfer_bytes,
      'device': ctx['name'],
      'num_chips': count,
      'bandwidth_gbps': per_chip_bw,
  }
  print(json.dumps(output), flush=True)
  return output


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument(
      '--num_chips',
      '--device_count',
      type=int,
      default=1,
      dest='num_chips',
  )
  parser.add_argument('--accelerator', type=str, default='auto')
  args = parser.parse_args()

  ctx = get_device_context(args.accelerator)
  count = args.num_chips
  if count > ctx.get('total_chips', 1):
    return

  import gc
  for dt in ['float32', 'bfloat16']:
    for op in ['Triad']:
      for per_chip_bytes in SIZES_PER_CHIP_BYTES:
        try:
          run_benchmark(ctx, count, per_chip_bytes, dt, op)
        except RuntimeError as e:
          if "RESOURCE_EXHAUSTED" in str(e) or "out of memory" in str(e).lower():
            break
          else:
            raise
        gc.collect()

if __name__ == '__main__':
  main()
