apiVersion: clickhouse.altinity.com/v1
kind: ClickHouseInstallation
metadata:
  name: {{ cluster_name }}
  namespace: clickhouse
spec:
  configuration:
    files:
      config.d/distributed_ddl.xml: |
        <clickhouse>
          <distributed_ddl_use_initial_user_and_roles>1</distributed_ddl_use_initial_user_and_roles>
        </clickhouse>
      users.d/{{ user }}.xml: |
        <clickhouse>
          <profiles>
            <default>
              <s3_allow_server_credentials_in_user_queries>1</s3_allow_server_credentials_in_user_queries>
              <distributed_ddl_entry_format_version>8</distributed_ddl_entry_format_version>
            </default>
          </profiles>
          <users>
            <{{ user }} replace="1">
              <password_sha256_hex>{{ password_sha256_hex }}</password_sha256_hex>
              <profile>default</profile>
              <networks>
                <ip>0.0.0.0/0</ip>
                <ip>::/0</ip>
              </networks>
            </{{ user }}>
          </users>
        </clickhouse>
    zookeeper:
      keeper:
        name: keeper-cluster
        namespace: clickhouse
    clusters:
      - name: {{ cluster_name }}
        layout:
          shardsCount: {{ num_shards }}
          replicasCount: {{ num_replicas }}
  defaults:
    templates:
      podTemplate: clickhouse-pod-template
  templates:
    podTemplates:
      - name: clickhouse-pod-template
        spec:
          containers:
            - name: clickhouse
              image: clickhouse/clickhouse-server:26.8
              resources:
                limits:
                  memory: {{ memory }}G
