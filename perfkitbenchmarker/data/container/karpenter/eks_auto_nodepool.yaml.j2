apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: {{ nodepool_name }}
spec:
  template:
    metadata:
      labels:
        pkb_nodepool: {{ nodepool_name }}
    spec:
      nodeClassRef:
        group: eks.amazonaws.com
        kind: NodeClass
        name: default
      taints:
        - key: pkb_nodepool
          value: {{ nodepool_name }}
          effect: NoSchedule
      requirements:
        - key: kubernetes.io/arch
          operator: In
          values: ["amd64"]
        - key: kubernetes.io/os
          operator: In
          values: ["linux"]
        - key: karpenter.sh/capacity-type
          operator: In
          values: ["{{ capacity_type | default('on-demand') }}"]
{% if machine_type %}
        - key: node.kubernetes.io/instance-type
          operator: In
          values: ["{{ machine_type }}"]
{% else %}
        - key: eks.amazonaws.com/instance-family
          operator: In
          values:
{% for family in instance_families %}
            - "{{ family }}"
{% endfor %}
{% endif %}
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 30s
